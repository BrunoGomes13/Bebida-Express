# Porta em que o servidor Express vai rodar
PORT=5000

# String de conexão do MongoDB (local ou MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/bebida_express

# Chave secreta usada para assinar os tokens JWT (troque por um valor forte e único)
JWT_SECRET=coloque_uma_chave_secreta_bem_forte_aqui
JWT_EXPIRES_IN=7d

# Usados apenas pelo script de seed (scripts/seedAdmin.js)
ADMIN_EMAIL=admin@bebidaexpress.com
ADMIN_SENHA=admin123
